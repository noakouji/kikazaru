---
import type { Copy } from '../copy'
import Base from '../layouts/Base.astro'
import Hero from './Hero.astro'
import Problem from './Problem.astro'
import Install from './Install.astro'
import Support from './Support.astro'
import DuckDemo from './DuckDemo.astro'

interface Props {
  t: Copy
}
const { t } = Astro.props

// 差し替えが1か所で済むように、外部リンクはここにまとめる。
const links = {
  download: '/Kikazaru.zip',
  repo: 'https://github.com/noakouji/kikazaru',
  form: 'https://docs.google.com/forms/d/e/1FAIpQLSefXhorrRPZcoxn_hRgREMqL48qcicouq6lu3wExYi97xUYjQ/viewform',
  kofi: 'https://ko-fi.com/kojiokada',
}
---

<Base title={t.meta.title} description={t.meta.description} htmlLang={t.htmlLang} altHref={t.altHref}>
  <nav class="topbar">
    <div class="wrap bar-inner">
      <a class="brand" href={t.lang === 'ja' ? '/' : '/en'}>
        <span class="brand-mark">🙉</span> Kikazaru
      </a>
      <div class="bar-right">
        {/* 2択なので、いまどちらを見ているかが分かる分割式にする */}
        <div class="lang" role="group" aria-label="Language">
          <a href="/" class:list={['seg', { on: t.lang === 'ja' }]} aria-current={t.lang === 'ja' ? 'true' : undefined} title="日本語">JA</a>
          <a href="/en" class:list={['seg', { on: t.lang === 'en' }]} aria-current={t.lang === 'en' ? 'true' : undefined} title="English">EN</a>
        </div>
        <a class="bar-dl" href={links.download} download>{t.nav.download}</a>
      </div>
    </div>
  </nav>

  <Hero t={t} downloadHref={links.download} />

  <section class="shot-band">
    <div class="wrap shot-inner">
      <img class="shot" src={t.shot.image} width="650" height="900" alt={t.shot.alt} loading="lazy" />
      <div class="shot-note">
        <h2>{t.shot.heading}</h2>
        <p set:html={t.shot.body.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')} />
        <p class="fine">{t.shot.fine}</p>
      </div>
    </div>
  </section>

  <Problem t={t} />

  <section class="section">
    <div class="wrap">
      <p class="section-label">{t.steps.label}</p>
      <h2>{t.steps.heading}</h2>
      <DuckDemo t={t} />
      <p class="lead">{t.steps.tail}</p>

      {/* 音が本体なので自動では再生しない。押して聞いてもらう */}
      <figure class="film">
        <video
          src="/kikazaru.mp4"
          poster="/kikazaru-poster.jpg"
          controls
          playsinline
          preload="none"
          width="1920"
          height="1080"
        ></video>
        <figcaption>
          <strong>{t.steps.video.title}</strong>
          {t.steps.video.note}
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="section-label">{t.speakers.label}</p>
      <h2>{t.speakers.heading}</h2>
      <ul class="speakers">
        {t.speakers.rows.map((s) => (
          <li class={s.state}>
            <span class="dot"></span>
            <strong>{s.name}</strong>
            <span class="note">{s.note}</span>
          </li>
        ))}
      </ul>
      <p class="lead">{t.speakers.tail}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="section-label">{t.why.label}</p>
      <h2>{t.why.heading}</h2>
      <p class="lead ctx">{t.why.body[0]}</p>
      <p class="lead ctx">{t.why.body[1]}<strong>{t.why.body[2]}</strong></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="section-label">{t.source.label}</p>
      <h2>{t.source.heading}</h2>
      <p class="lead ctx">{t.source.body[0]}</p>
      <p class="lead ctx">{t.source.body[1]}</p>
      <a class="repo" href={links.repo} target="_blank" rel="noopener">
        <svg width="19" height="19" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
        </svg>
        {t.source.cta}
      </a>
      <p class="fine repo-note">{t.source.note}</p>
    </div>
  </section>

  <Install t={t} formHref={links.form} />
  <Support t={t} formHref={links.form} />

  <footer class="foot">
    <div class="wrap">
      <div class="foot-links">
        <a href="#install">{t.foot.install}</a>
        <a href="#support">{t.foot.support}</a>
        <a href={links.repo} target="_blank" rel="noopener">GitHub</a>
        <a href={t.altHref}>{t.altLabel}</a>
      </div>
      <p class="copy">{t.foot.copy}</p>
    </div>
  </footer>
</Base>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(247, 245, 241, 0.86);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }

  .bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 52px;
  }

  .brand {
    font-weight: 700;
    letter-spacing: 0.01em;
    display: flex;
    align-items: center;
    gap: 7px;
    text-decoration: none;
  }

  .brand-mark { font-size: 19px; }

  .bar-right {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  /* 言語切り替え。押しボタンではなく「いまどちら側にいるか」を示す目盛りとして見せる */
  .lang {
    display: inline-flex;
    align-items: stretch;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.03);
    padding: 2px;
  }

  .seg {
    /* 左右の幅を揃えると、押しボタンではなく目盛りとして読める */
    min-width: 34px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
    color: var(--ink-faint);
    text-decoration: none;
    padding: 7px 0;
    border-radius: 999px;
    display: grid;
    place-items: center;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    transition: color 0.14s ease, background 0.14s ease;
  }

  .seg:hover { color: var(--ink); }

  .seg.on {
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
  }

  .bar-dl {
    font-size: 13.5px;
    font-weight: 700;
    text-decoration: none;
    padding: 7px 14px;
    border-radius: 7px;
    background: var(--dark);
    color: var(--paper);
  }

  .shot-band {
    background: var(--paper-deep);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 56px 0;
  }

  .shot-inner {
    display: grid;
    grid-template-columns: 330px 1fr;
    gap: 40px;
    align-items: center;
  }

  .shot {
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--line);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.14);
  }

  .shot-note h2 { font-size: clamp(20px, 3.6vw, 26px); margin-bottom: 14px; }
  .shot-note p { font-size: 15px; color: var(--ink-soft); }
  .shot-note p + p { margin-top: 12px; }
  .shot-note strong { color: var(--ink); }
  .fine { font-size: 13.5px; }

  .ctx { max-width: 38em; }
  .ctx + .ctx { margin-top: 14px; }
  .ctx strong { color: var(--ink); }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-bottom: 24px;
  }

  .step {
    border: 1px solid var(--line);
    background: #fff;
    border-radius: 12px;
    padding: 20px;
  }

  .emoji { font-size: 28px; display: block; margin-bottom: 8px; }
  .step h3 { font-size: 16px; margin-bottom: 4px; }
  .step p { font-size: 14px; color: var(--ink-soft); }

  .speakers {
    list-style: none;
    padding: 0;
    margin: 0 0 22px;
    display: grid;
    gap: 2px;
  }

  .speakers li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 11px 2px;
    border-bottom: 1px solid var(--line);
    flex-wrap: wrap;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex: none;
    transform: translateY(-1px);
  }

  .ok .dot { background: var(--ok); }
  .wip .dot { background: #d08a3c; }
  .sub .dot { background: var(--ink-faint); }

  .speakers strong { font-weight: 600; }
  .note { font-size: 13.5px; color: var(--ink-faint); }

  /* 動画。押して見てもらう前提なので、静止画のまま置いても意味が通るコマを表紙にする */
  .film {
    margin: 26px 0 0;
  }

  .film video {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--dark);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.13);
  }

  .film figcaption {
    margin-top: 12px;
    font-size: 13.5px;
    color: var(--ink-soft);
  }

  .film figcaption strong {
    color: var(--ink);
    margin-right: 8px;
  }

  .repo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 22px;
    padding: 12px 20px;
    border-radius: 9px;
    background: var(--dark);
    color: var(--paper);
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 2px 0 rgba(0, 0, 0, 0.28);
  }

  .repo:hover { transform: translateY(1px); box-shadow: 0 1px 0 rgba(0, 0, 0, 0.28); }

  .repo-note { margin-top: 12px; color: var(--ink-faint); font-size: 13px; }

  .foot {
    border-top: 1px solid var(--line);
    padding: 46px 0 64px;
  }

  .foot-links {
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
    margin: 0 0 22px;
  }

  .foot-links a { color: var(--accent); font-size: 15px; text-underline-offset: 3px; }
  .copy { font-size: 13px; color: var(--ink-faint); }

  @media (max-width: 720px) {
    .shot-inner { grid-template-columns: 1fr; gap: 24px; }
    .shot { max-width: 320px; }
  }

  @media (max-width: 640px) {
    .steps { grid-template-columns: 1fr; }
  }
</style>
