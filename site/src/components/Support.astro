---
import type { Copy } from '../copy'

interface Props {
  t: Copy
  formHref: string
  kofiHref: string
}
const { t, formHref, kofiHref } = Astro.props
const s = t.support

// 無料で配っているものなので、支援の導線は目立たせすぎない。
// ただし「どこにあるか分からない」のも困るので、独立した区画にはしておく。
---

<section class="section" id="support">
  <div class="wrap">
    <p class="section-label">{s.label}</p>
    <h2>{s.heading}</h2>

    <div class="cards">
      <div class="card">
        <span class="ico">🛠</span>
        <h3>{s.bugTitle}</h3>
        <p>{s.bugBody}</p>
        <a class="btn" href={formHref} target="_blank" rel="noopener">{s.bugBtn}</a>
      </div>

      <div class="card">
        <span class="ico">☕️</span>
        <h3>{s.kofiTitle}</h3>
        <p>{s.kofiBody}</p>
        <a class="btn kofi" href={kofiHref} target="_blank" rel="noopener">{s.kofiBtn}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 24px;
    display: flex;
    flex-direction: column;
  }

  .ico { font-size: 26px; margin-bottom: 10px; }

  .card h3 {
    font-size: 17px;
    margin-bottom: 8px;
  }

  .card p {
    font-size: 14.5px;
    color: var(--ink-soft);
    flex: 1;
    margin-bottom: 18px;
  }

  .btn {
    align-self: flex-start;
    display: inline-block;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    padding: 10px 18px;
    border-radius: 8px;
    border: 1px solid var(--dark);
    color: var(--dark);
  }

  .btn:hover { background: var(--dark); color: var(--paper); }

  .btn.kofi {
    border-color: var(--accent);
    color: #fff;
    background: var(--accent);
  }

  .btn.kofi:hover { opacity: 0.88; background: var(--accent); color: #fff; }

  .btn.soon {
    border-style: dashed;
    border-color: var(--line);
    color: var(--ink-faint);
    font-weight: 400;
  }

  @media (max-width: 640px) {
    .cards { grid-template-columns: 1fr; }
  }
</style>
