---
import type { Copy } from '../copy'

interface Props {
  t: Copy
  formHref: string
  kofiHref: string
}
const { t, formHref, kofiHref } = Astro.props
const s = t.support

// 無料で配っているものなので、支援の導線は目立たせすぎない。
// ただし Ko-fi のページへ飛ばすと、金額を選ぶ前に一度サイトを離れることになる。
// パネルをそのまま埋め込んで、ここで完結できるようにする。
const kofiPanel = `${kofiHref}/?hidefeed=true&widget=true&embed=true&preview=true`
---

<section class="section" id="support">
  <div class="wrap">
    <p class="section-label">{s.label}</p>
    <h2>{s.heading}</h2>

    <div class="cards">
      <div class="card">
        <span class="ico">🛠</span>
        <h3>{s.bugTitle}</h3>
        <p>{s.bugBody}</p>
        <a class="btn" href={formHref} target="_blank" rel="noopener">{s.bugBtn}</a>
      </div>

      <div class="card kofi-card">
        <span class="ico">☕️</span>
        <h3>{s.kofiTitle}</h3>
        <p>{s.kofiBody}</p>
        <iframe
          class="kofi"
          src={kofiPanel}
          title={s.kofiBtn}
          height="520"
          loading="lazy"
        ></iframe>
        <a class="fallback" href={kofiHref} target="_blank" rel="noopener">{s.kofiFallback}</a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Ko-fi のパネルは背が高く、横に並べると左が空白だらけになる。
     縦に積んで、読む順（まず不具合、次に支援）をそのまま並びにする */
  .cards {
    display: grid;
    gap: 16px;
  }

  .card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 24px;
    display: flex;
    flex-direction: column;
  }

  .ico { font-size: 26px; margin-bottom: 10px; }

  .card h3 {
    font-size: 17px;
    margin-bottom: 8px;
  }

  .card p {
    font-size: 14.5px;
    color: var(--ink-soft);
    margin-bottom: 18px;
    /* 横幅いっぱいだと1行が長くなりすぎる */
    max-width: 42em;
  }

  .btn {
    align-self: flex-start;
    display: inline-block;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    padding: 10px 18px;
    border-radius: 8px;
    border: 1px solid var(--dark);
    color: var(--dark);
  }

  .btn:hover { background: var(--dark); color: var(--paper); }

  .btn.kofi {
    border-color: var(--accent);
    color: #fff;
    background: var(--accent);
  }

  .btn.kofi:hover { opacity: 0.88; background: var(--accent); color: #fff; }

  .btn.soon {
    border-style: dashed;
    border-color: var(--line);
    color: var(--ink-faint);
    font-weight: 400;
  }

  /* Ko-fi のパネルはあちらの意匠なので、枠で囲って「外部のもの」として見せる */
  .kofi {
    /* パネル自体の中身は 400px 程度。広げても余白が増えるだけなので抑える */
    width: 100%;
    max-width: 440px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #fff;
    display: block;
    margin-bottom: 10px;
  }

  .kofi-card p { margin-bottom: 14px; }

  .fallback {
    font-size: 12.5px;
    color: var(--ink-faint);
    text-underline-offset: 3px;
  }

  .fallback:hover { color: var(--accent); }


</style>
