---
import type { Copy } from '../copy'

interface Props {
  t: Copy
  formHref: string
}
const { t, formHref } = Astro.props
const s = t.support

// トップには支払いパネルを置かない。ここに埋めると、
// 「使い方を読みに来た人」の画面にいきなり金額が出て圧が強い。
// 詳しく知りたい人だけ専用ページへ送る。
const supportHref = t.lang === 'ja' ? '/support' : '/en/support'
---

<section class="section" id="support">
  <div class="wrap">
    <p class="section-label">{s.label}</p>
    <h2>{s.heading}</h2>

    <div class="cards">
      <div class="card">
        <h3><span class="ico">🛠</span>{s.bugTitle}</h3>
        <p>{s.bugBody}</p>
        <a class="btn" href={formHref} target="_blank" rel="noopener">{s.bugBtn}</a>
      </div>

      <div class="card">
        <h3><span class="ico">☕️</span>{s.kofiTitle}</h3>
        <p>{s.kofiBody}</p>
        <a class="btn kofi" href={supportHref}>{s.kofiBtn}</a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Ko-fi のパネルは背が高く、横に並べると左が空白だらけになる。
     縦に積んで、読む順（まず不具合、次に支援）をそのまま並びにする */
  .cards {
    display: grid;
    gap: 16px;
  }

  .card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 24px;
    display: flex;
    flex-direction: column;
  }

  /* 絵文字は単独の行に置かない。1個だけ浮くと孤立して見える。
     見出しの一部にすると、記号として役割が生まれる */
  .card h3 {
    font-size: 17px;
    margin-bottom: 8px;
    display: flex;
    align-items: baseline;
    gap: 9px;
  }

  .ico {
    font-size: 19px;
    line-height: 1;
    flex: none;
  }

  .card p {
    font-size: 14.5px;
    color: var(--ink-soft);
    margin-bottom: 18px;
    /* 横幅いっぱいだと1行が長くなりすぎる */
    max-width: 42em;
  }

  .btn {
    align-self: flex-start;
    display: inline-block;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    padding: 10px 18px;
    border-radius: 8px;
    border: 1px solid var(--dark);
    color: var(--dark);
  }

  .btn:hover { background: var(--dark); color: var(--paper); }

  .btn.kofi {
    border-color: var(--accent);
    color: #fff;
    background: var(--accent);
  }

  .btn.kofi:hover { opacity: 0.88; background: var(--accent); color: #fff; }

  .btn.soon {
    border-style: dashed;
    border-color: var(--line);
    color: var(--ink-faint);
    font-weight: 400;
  }


</style>
