---
// 手順の図。画像ファイルは持たず SVG で描く。
// 拡大しても滲まず、文字がそのまま検索・翻訳できる。
interface Props {
  kind: 'contextMenu' | 'dialog' | 'menubar' | 'settings'
}
const { kind } = Astro.props
---

{kind === 'contextMenu' && (
  <svg class="fig" viewBox="0 0 420 210" role="img" aria-label="アイコンを右クリックして「開く」を選ぶ">
    <rect width="420" height="210" rx="10" class="bg" />
    {/* アプリのアイコン */}
    <rect x="34" y="52" width="62" height="62" rx="14" class="icon" />
    <text x="65" y="95" class="emoji" text-anchor="middle">🙉</text>
    <text x="65" y="132" class="cap" text-anchor="middle">Kikazaru</text>
    {/* 右クリックのしるし */}
    <circle cx="98" cy="112" r="15" class="ring" />
    <text x="98" y="117" class="ringtext" text-anchor="middle">右</text>
    {/* メニュー */}
    <rect x="150" y="40" width="196" height="132" rx="9" class="menu" />
    <rect x="156" y="48" width="184" height="26" rx="6" class="hit" />
    <text x="168" y="66" class="item hit-text">開く</text>
    <text x="168" y="96" class="item dim">"Kikazaru" を圧縮</text>
    <text x="168" y="122" class="item dim">情報を見る</text>
    <text x="168" y="148" class="item dim">ゴミ箱に入れる</text>
    {/* 指し示し */}
    <path d="M112 88 C130 70, 138 62, 150 60" class="arrow" fill="none" />
    <path d="M150 60 l-9 -2 l4 7 z" class="arrowhead" />
  </svg>
)}

{kind === 'dialog' && (
  <svg class="fig" viewBox="0 0 420 210" role="img" aria-label="確認画面でもう一度「開く」を押す">
    <rect width="420" height="210" rx="10" class="bg" />
    <rect x="86" y="26" width="248" height="158" rx="12" class="menu" />
    <text x="210" y="62" class="emoji sm" text-anchor="middle">⚠️</text>
    <text x="210" y="92" class="dlg-title" text-anchor="middle">"Kikazaru" の開発元を</text>
    <text x="210" y="110" class="dlg-title" text-anchor="middle">検証できません</text>
    <text x="210" y="132" class="dlg-body" text-anchor="middle">本当に開いてもよろしいですか？</text>
    <rect x="106" y="146" width="94" height="26" rx="6" class="btn-plain" />
    <text x="153" y="164" class="btn-text dim" text-anchor="middle">キャンセル</text>
    <rect x="216" y="146" width="94" height="26" rx="6" class="btn-key" />
    <text x="263" y="164" class="btn-text key" text-anchor="middle">開く</text>
  </svg>
)}

{kind === 'menubar' && (
  <svg class="fig" viewBox="0 0 420 130" role="img" aria-label="メニューバーに絵文字が出る">
    <rect width="420" height="130" rx="10" class="bg" />
    <rect x="20" y="24" width="380" height="30" rx="7" class="bar" />
    <circle cx="288" cy="39" r="4" class="dim-dot" />
    <circle cx="308" cy="39" r="4" class="dim-dot" />
    <text x="336" y="45" class="emoji sm" text-anchor="middle">🐵</text>
    <circle cx="380" cy="39" r="4" class="dim-dot" />
    <path d="M336 62 l0 18" class="arrow" />
    <path d="M336 84 l-4 -8 l8 0 z" class="arrowhead" />
    <text x="336" y="104" class="cap" text-anchor="middle">ここに出ます</text>
    <text x="90" y="45" class="cap" text-anchor="middle">画面いちばん上</text>
  </svg>
)}

{kind === 'settings' && (
  <svg class="fig" viewBox="0 0 420 250" role="img" aria-label="設定画面でスピーカーにチェックを入れる">
    <rect width="420" height="250" rx="10" class="bg" />
    <rect x="40" y="20" width="340" height="212" rx="10" class="menu" />
    <rect x="40" y="20" width="340" height="24" rx="10" class="titlebar" />
    <circle cx="56" cy="32" r="4" fill="#ff5f57" />
    <circle cx="70" cy="32" r="4" fill="#febc2e" />
    <circle cx="84" cy="32" r="4" fill="#28c840" />
    <text x="62" y="70" class="emoji sm">🙉</text>
    <text x="90" y="66" class="dlg-title">Kikazaru</text>
    <text x="62" y="98" class="sec">どのスピーカーを下げるか</text>

    <rect x="62" y="108" width="296" height="54" rx="7" class="panel" />
    <text x="74" y="126" class="sec sm">Sonos</text>
    <rect x="74" y="134" width="11" height="11" rx="3" class="check" />
    <path d="M76.5 139.5 l2.5 2.5 l4.5 -5" class="tick" fill="none" />
    <text x="92" y="144" class="item">オフィス</text>
    <text x="330" y="144" class="ok" text-anchor="end">下げる</text>

    <rect x="62" y="170" width="296" height="50" rx="7" class="panel" />
    <text x="74" y="188" class="sec sm">Google Home</text>
    <rect x="74" y="196" width="11" height="11" rx="3" class="check off" />
    <text x="92" y="206" class="item">リビング</text>
    <text x="330" y="206" class="dim2" text-anchor="end">そのまま</text>
  </svg>
)}

<style>
  .fig {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #fff;
  }

  .bg { fill: #faf8f5; }
  .icon { fill: #2f6fd0; }
  .menu { fill: #fff; stroke: #d8d2c8; stroke-width: 1; }
  .panel { fill: #f2efea; }
  .titlebar { fill: #eeeae4; }
  .bar { fill: #e9e5df; }
  .hit { fill: #2f6fd0; }

  .emoji { font-size: 26px; }
  .emoji.sm { font-size: 18px; }

  text {
    font-family: 'Hiragino Sans', system-ui, sans-serif;
    fill: #1b1a1f;
  }

  .item { font-size: 12px; }
  .hit-text { fill: #fff; font-weight: 700; }
  .dim { fill: #9a958d; }
  .dim2 { fill: #9a958d; font-size: 11px; }
  .cap { font-size: 11px; fill: #7d7871; }
  .sec { font-size: 12px; font-weight: 700; }
  .sec.sm { font-size: 10.5px; fill: #55525c; }
  .dlg-title { font-size: 13px; font-weight: 700; }
  .dlg-body { font-size: 11px; fill: #55525c; }
  .btn-text { font-size: 11px; }
  .btn-text.key { fill: #fff; font-weight: 700; }
  .btn-plain { fill: #f1eee9; stroke: #d8d2c8; }
  .btn-key { fill: #2f6fd0; }
  .ok { fill: #3f7d54; font-size: 11px; }
  .dim-dot { fill: #b8b2a8; }
  .check { fill: #2f6fd0; }
  .check.off { fill: #fff; stroke: #b8b2a8; }
  .tick { stroke: #fff; stroke-width: 1.6; stroke-linecap: round; }

  .arrow { stroke: #b4622f; stroke-width: 2; fill: none; }
  .arrowhead { fill: #b4622f; }
  .ring { fill: none; stroke: #b4622f; stroke-width: 2; }
  .ringtext { font-size: 11px; fill: #b4622f; font-weight: 700; }
</style>
