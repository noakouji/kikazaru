---
import type { Copy } from '../copy'
import BeforeAfter from './BeforeAfter.astro'

interface Props {
  t: Copy
}
const { t } = Astro.props
const p = t.problem

// 「困っていること」ではなく「やりたいこと」から入る。
// 音楽を止めたいのではなく、流したまま働きたい。そこを先に置く。
---

<section class="problem">
  <div class="wrap">
    <p class="label">{p.label}</p>
    <h2>{p.heading}</h2>
    <p class="want">{p.want}</p>

    <BeforeAfter t={t} />

    <div class="cause">
      <h3>{p.causeHeading}</h3>
      <p>{p.causeLead[0]}<strong>{p.causeLead[1]}</strong>{p.causeLead[2]}</p>
      <div class="split">
        <div class="case ok">
          <span class="mark">{p.okMark}</span>
          <p>{p.okName}<br /><small>{p.okNote}</small></p>
        </div>
        <div class="case ng">
          <span class="mark">{p.ngMark}</span>
          <p>{p.ngName}<br /><small>{p.ngNote}</small></p>
        </div>
      </div>
      <p>{p.causeTail[0]}<strong>{p.causeTail[1]}</strong></p>
    </div>
  </div>
</section>

<style>
  .problem {
    background: var(--dark);
    color: #efe9e2;
    padding: 76px 0;
  }

  .label {
    font-size: 13px;
    letter-spacing: 0.12em;
    color: rgba(239, 233, 226, 0.45);
    margin-bottom: 10px;
  }

  h2 {
    font-size: clamp(21px, 4.4vw, 30px);
    margin-bottom: 16px;
  }

  .want {
    color: rgba(239, 233, 226, 0.7);
    font-size: 15px;
    max-width: 40em;
    margin-bottom: 30px;
  }

  .cause {
    margin-top: 40px;
    padding-top: 30px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .cause h3 {
    font-size: 18px;
    margin-bottom: 12px;
  }

  .cause p {
    color: rgba(239, 233, 226, 0.7);
    font-size: 15px;
  }

  .cause strong { color: #efe9e2; }

  .split {
    margin: 20px 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .case {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    padding: 16px 18px;
  }

  .case p { font-size: 15px; }

  .case small {
    color: rgba(239, 233, 226, 0.45);
    font-size: 13px;
  }

  .mark {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: 999px;
    margin-bottom: 8px;
  }

  .ok .mark { background: rgba(96, 200, 132, 0.16); color: #6fd394; }
  .ng .mark { background: rgba(255, 138, 92, 0.16); color: #ff9d6b; }

  @media (max-width: 560px) {
    .split { grid-template-columns: 1fr; }
  }
</style>
