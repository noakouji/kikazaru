---
import type { Copy } from '../copy'

interface Props {
  t: Copy
}
const { t } = Astro.props
const d = t.steps.demo

// 5秒で一巡。
// 「音量」という数字ではなく、スピーカーから歌詞が流れてくる絵にする。
// 喋りはじめると歌詞が引っ込み、音声入力の結果がきれいに出る。
// JavaScript は使わない。
---

<div class="demo" role="img" aria-label={`${d.micOn} → ${d.quiet}`}>
  <div class="stage">
    <span class="who">🔊</span>
    <span class="flow">
      {/* 歌詞が右へ流れていく。曲が鳴っていることを言葉で説明しない */}
      <span class="song"><i>♪</i>{d.song}<i>♪</i></span>
      <span class="song echo" aria-hidden="true"><i>♪</i>{d.song}<i>♪</i></span>
    </span>
  </div>

  <div class="labels">
    <span class="cap">
      <span class="s-loud">{d.speaker}・{d.loud}</span>
      <span class="s-quiet">{d.speaker}・{d.quiet}</span>
    </span>
  </div>

  <div class="stage mic-row">
    <span class="who">🎙</span>
    <span class="cap">
      <span class="s-loud">{d.micOff}</span>
      <span class="s-quiet on">{d.micOn}</span>
    </span>
  </div>

  <div class="out">
    <span class="out-label">{d.transcript}</span>
    <p class="line"><span>{d.line}</span></p>
  </div>
</div>

<style>
  .demo {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 22px 24px 24px;
    margin-bottom: 24px;
  }

  .stage {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .who {
    font-size: 30px;
    line-height: 1;
    flex: none;
    width: 36px;
  }

  /* 歌詞が流れる帯。はみ出したぶんは切る */
  .flow {
    position: relative;
    flex: 1;
    height: 40px;
    overflow: hidden;
    display: flex;
    align-items: center;
    /* 両端をぼかす。文字が枠でぶつ切りになると、流れているように見えない */
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 84%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 84%, transparent);
  }

  .song {
    position: absolute;
    left: 0;
    white-space: nowrap;
    font-size: 21px;
    font-weight: 700;
    color: var(--accent);
    transform-origin: left center;
    animation: drift 5s linear infinite, shrink 5s infinite;
  }

  .song i {
    font-style: normal;
    opacity: 0.55;
    margin: 0 10px;
  }

  /* 2本目を半周ずらして流し、途切れないようにする */
  .echo { animation-delay: -2.5s, 0s; }

  .labels { margin: 2px 0 14px 50px; }
  .mic-row { margin-bottom: 18px; }

  .cap {
    display: inline-grid;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--ink-soft);
  }

  .cap > span { grid-area: 1 / 1; white-space: nowrap; }
  .s-loud { animation: hideWhenQuiet 5s infinite; }
  .s-quiet { opacity: 0; animation: showWhenQuiet 5s infinite; }
  .s-quiet.on { color: var(--accent); }

  .out {
    background: var(--paper-deep);
    border-radius: 11px;
    padding: 14px 16px 16px;
  }

  .out-label {
    display: block;
    font-size: 11.5px;
    color: var(--ink-faint);
    margin-bottom: 5px;
  }

  .line {
    font-size: 19px;
    font-weight: 600;
    color: var(--ink);
    min-height: 1.5em;
  }

  /* 等幅でなくても崩れないよう、文字を左から削り出す */
  .line span {
    display: inline-block;
    clip-path: inset(0 100% 0 0);
    animation: typing 5s infinite;
  }

  /* 左へ流れ続ける。カラオケと同じ向きで、読みながら追える */
  @keyframes drift {
    from { transform: translateX(0%); }
    to { transform: translateX(-52%); }
  }

  /* 喋りはじめたら、歌詞が小さく薄くなって引っ込む */
  @keyframes shrink {
    0%, 20% { font-size: 21px; opacity: 1; }
    26%, 74% { font-size: 12px; opacity: 0.28; }
    80%, 100% { font-size: 21px; opacity: 1; }
  }

  @keyframes showWhenQuiet {
    0%, 19% { opacity: 0; }
    25%, 74% { opacity: 1; }
    80%, 100% { opacity: 0; }
  }

  @keyframes hideWhenQuiet {
    0%, 19% { opacity: 1; }
    25%, 74% { opacity: 0; }
    80%, 100% { opacity: 1; }
  }

  @keyframes typing {
    0%, 28% { clip-path: inset(0 100% 0 0); }
    56%, 74% { clip-path: inset(0 0 0 0); }
    80%, 100% { clip-path: inset(0 100% 0 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .demo * { animation: none !important; }
    .song { font-size: 12px; opacity: 0.28; }
    .echo { display: none; }
    .s-loud { opacity: 0; }
    .s-quiet { opacity: 1; }
    .line span { clip-path: inset(0 0 0 0); }
  }

  @media (max-width: 560px) {
    .line { font-size: 16px; }
    .song { font-size: 17px; }
  }
</style>
