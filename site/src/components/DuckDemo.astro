---
import type { Copy } from '../copy'

interface Props {
  t: Copy
}
const { t } = Astro.props
const d = t.steps.demo

// 「入れるとどうなるか」は、入れなかった場合と並べたときに一番速く伝わる。
// 上下2本を同時に走らせ、同じ瞬間に喋りはじめて、結果だけが違うようにする。
// 5秒で一巡。JavaScript は使わない。
---

<div class="demo" role="img" aria-label={`${d.without} / ${d.with}`}>
  <p class="cue"><span class="dot"></span>🎙 {d.micOn}</p>

  <div class="lane bad">
    <span class="tag">{d.without}</span>
    <div class="body">
      <div class="flow">
        <span class="track">
          <span class="song"><i>♪</i>{d.song}<i>♪</i></span>
          <span class="song" aria-hidden="true"><i>♪</i>{d.song}<i>♪</i></span>
        </span>
      </div>
      <p class="out">
        <span class="out-label">{d.transcript}</span>
        {/* 文末ではなく文の途中に割り込ませる。実際の誤認識はこう出る */}
        <span class="line">
          <span class="clean"
            >{d.lineA}<em class="dirt">{d.dirtA}</em>{d.lineB}<em class="dirt">{d.dirtB}</em></span
          >
        </span>
      </p>
    </div>
  </div>

  <div class="lane good">
    <span class="tag">{d.with}</span>
    <div class="body">
      <div class="flow quiet">
        <span class="track">
          <span class="song"><i>♪</i>{d.song}<i>♪</i></span>
          <span class="song" aria-hidden="true"><i>♪</i>{d.song}<i>♪</i></span>
        </span>
      </div>
      <p class="out">
        <span class="out-label">{d.transcript}</span>
        <span class="line"><span class="clean">{d.lineA}{d.lineB}</span></span>
      </p>
    </div>
  </div>
</div>

<style>
  .demo { margin-bottom: 24px; }

  /* 喋りはじめる合図。上下どちらにも同じ瞬間に効いていることを示す */
  .cue {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 14px;
    font-weight: 700;
    color: var(--ink-faint);
    margin-bottom: 12px;
    animation: cueOn 5s infinite;
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 5s infinite;
  }

  .lane {
    display: grid;
    grid-template-columns: 128px 1fr;
    align-items: stretch;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #fff;
    overflow: hidden;
  }

  .lane + .lane { margin-top: 10px; }

  .tag {
    display: grid;
    place-items: center;
    font-size: 13px;
    font-weight: 700;
    text-align: center;
    padding: 0 10px;
    line-height: 1.4;
  }

  .bad .tag { background: rgba(0, 0, 0, 0.045); color: var(--ink-faint); }
  .good .tag { background: var(--accent-soft); color: var(--accent); }

  .body { padding: 14px 16px 15px; min-width: 0; }

  /* 歌詞が流れる帯 */
  .flow {
    height: 30px;
    overflow: hidden;
    display: flex;
    align-items: center;
    transform-origin: left center;
    mask-image: linear-gradient(90deg, transparent, #000 5%, #000 86%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 86%, transparent);
  }

  /* 入れた側だけ、喋りはじめると引っ込む */
  .flow.quiet { animation: shrink 5s infinite; }

  /* 同じ歌詞を2枚つなげ、半分だけ動かすと途切れずに繋がる */
  .track {
    display: flex;
    flex: none;
    animation: drift 5s linear infinite;
  }

  .song {
    white-space: nowrap;
    padding-right: 48px;
    font-size: 17px;
    font-weight: 700;
    color: var(--accent);
  }

  .song i { font-style: normal; opacity: 0.55; margin: 0 8px; }

  .out {
    margin-top: 10px;
    background: var(--paper-deep);
    border-radius: 9px;
    padding: 10px 12px 12px;
  }

  .out-label {
    display: block;
    font-size: 11px;
    color: var(--ink-faint);
    margin-bottom: 3px;
  }

  .line {
    display: block;
    font-size: 16px;
    font-weight: 600;
    color: var(--ink);
    min-height: 1.5em;
  }

  /* 等幅でなくても崩れないよう、左から削り出す */
  .clean {
    display: inline-block;
    clip-path: inset(0 100% 0 0);
    animation: typing 5s infinite;
  }

  /* 入れなかった側にだけ、歌詞が混ざる。
     打たれていく文字と一緒に現れるので、あとから足しても行がずれない */
  .dirt {
    margin: 0 4px;
    padding: 1px 6px;
    border-radius: 5px;
    background: rgba(180, 98, 47, 0.16);
    color: var(--accent);
    font-style: normal;
  }

  @keyframes drift {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @keyframes shrink {
    0%, 18% { transform: scale(1); opacity: 1; }
    24%, 74% { transform: scale(0.5); opacity: 0.26; }
    80%, 100% { transform: scale(1); opacity: 1; }
  }

  @keyframes cueOn {
    0%, 18% { color: var(--ink-faint); }
    22%, 74% { color: var(--accent); }
    80%, 100% { color: var(--ink-faint); }
  }

  @keyframes pulse {
    0%, 18% { opacity: 0.2; transform: scale(0.8); }
    22% { opacity: 1; transform: scale(1.35); }
    30%, 74% { opacity: 1; transform: scale(1); }
    80%, 100% { opacity: 0.2; transform: scale(0.8); }
  }

  @keyframes typing {
    0%, 26% { clip-path: inset(0 100% 0 0); }
    54%, 74% { clip-path: inset(0 0 0 0); }
    80%, 100% { clip-path: inset(0 100% 0 0); }
  }


  @media (prefers-reduced-motion: reduce) {
    .demo * { animation: none !important; }
    .flow.quiet { transform: scale(0.5); opacity: 0.26; }
    .clean { clip-path: inset(0 0 0 0); }
    .cue { color: var(--accent); }
    .dot { opacity: 1; }
  }

  @media (max-width: 620px) {
    .lane { grid-template-columns: 1fr; }
    .tag { padding: 8px 12px; place-items: center start; }
    .line { font-size: 15px; }
    .song { font-size: 15px; }
  }
</style>
