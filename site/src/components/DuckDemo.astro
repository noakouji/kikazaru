---
import type { Copy } from '../copy'

interface Props {
  t: Copy
}
const { t } = Astro.props
const d = t.steps.demo

// 数字のバーはやめた。「20 が 6 になる」と言われても、それが大きいのか小さいのか分からない。
// 音の棒が減る／文字起こしがきれいに出る、という結果だけを見せる。
// 8秒で一巡。JavaScript は使わない。
---

<div class="demo" role="img" aria-label={`${d.micOn} → ${d.quiet}`}>
  <div class="stage">
    <span class="who">🔊</span>
    <span class="col">
      <span class="bars" aria-hidden="true">
        <i></i><i></i><i></i><i></i><i></i>
      </span>
      <span class="cap">
        <span class="s-loud">{d.speaker} · {d.loud}</span>
        <span class="s-quiet">{d.speaker} · {d.quiet}</span>
      </span>
    </span>
  </div>

  <div class="stage mic-row">
    <span class="who">🎙</span>
    <span class="cap">
      <span class="s-loud">{d.micOff}</span>
      <span class="s-quiet on">{d.micOn}</span>
    </span>
  </div>

  <div class="out">
    <span class="out-label">{d.transcript}</span>
    <p class="line"><span>{d.line}</span></p>
  </div>
</div>

<style>
  .demo {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 26px 28px 28px;
    margin-bottom: 24px;
  }

  .stage {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 18px;
  }

  .mic-row { margin-bottom: 22px; }

  .who {
    font-size: 30px;
    line-height: 1;
    flex: none;
    width: 38px;
  }

  .col { display: grid; gap: 7px; }

  /* 音の大きさ。棒が減るところを見せる。数字より速く伝わる */
  .bars {
    display: flex;
    align-items: flex-end;
    gap: 5px;
    height: 34px;
  }

  .bars i {
    width: 7px;
    border-radius: 3px;
    background: var(--ink);
    transform-origin: bottom;
    animation: quieten 8s infinite;
  }

  .bars i:nth-child(1) { height: 12px; }
  .bars i:nth-child(2) { height: 20px; animation-name: dropOut; animation-delay: 0.02s; }
  .bars i:nth-child(3) { height: 28px; animation-name: dropOut; animation-delay: 0.05s; }
  .bars i:nth-child(4) { height: 34px; animation-name: dropOut; animation-delay: 0.08s; }
  .bars i:nth-child(5) { height: 22px; animation-name: dropOut; animation-delay: 0.11s; }

  /* 状態の言葉。2つ重ねて入れ替える */
  .cap {
    display: inline-grid;
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-soft);
  }

  .cap > span { grid-area: 1 / 1; white-space: nowrap; }
  .s-loud { animation: hideWhenQuiet 8s infinite; }
  .s-quiet { opacity: 0; animation: showWhenQuiet 8s infinite; }
  .s-quiet.on { color: var(--accent); }

  /* 結果。ここが本題なので、いちばん下に大きく置く */
  .out {
    background: var(--paper-deep);
    border-radius: 11px;
    padding: 15px 18px 17px;
  }

  .out-label {
    display: block;
    font-size: 11.5px;
    color: var(--ink-faint);
    margin-bottom: 5px;
  }

  .line {
    font-size: 19px;
    font-weight: 600;
    color: var(--ink);
    min-height: 1.5em;
  }

  /* 文字が左から現れる。等幅でなくても崩れないよう clip-path で削る */
  .line span {
    display: inline-block;
    clip-path: inset(0 100% 0 0);
    animation: typing 8s infinite;
  }

  @keyframes quieten {
    0%, 18% { height: 12px; opacity: 1; background: var(--ink); }
    24%, 70% { height: 8px; opacity: 1; background: var(--accent); }
    76%, 100% { height: 12px; opacity: 1; background: var(--ink); }
  }

  @keyframes dropOut {
    0%, 18% { transform: scaleY(1); opacity: 1; background: var(--ink); }
    24%, 70% { transform: scaleY(0.1); opacity: 0.25; background: var(--accent); }
    76%, 100% { transform: scaleY(1); opacity: 1; background: var(--ink); }
  }

  @keyframes showWhenQuiet {
    0%, 17% { opacity: 0; }
    22%, 70% { opacity: 1; }
    75%, 100% { opacity: 0; }
  }

  @keyframes hideWhenQuiet {
    0%, 17% { opacity: 1; }
    22%, 70% { opacity: 0; }
    75%, 100% { opacity: 1; }
  }

  @keyframes typing {
    0%, 26% { clip-path: inset(0 100% 0 0); }
    52%, 70% { clip-path: inset(0 0 0 0); }
    75%, 100% { clip-path: inset(0 100% 0 0); }
  }

  /* 動きが苦手な人には、下がりきった状態を静止で見せる */
  @media (prefers-reduced-motion: reduce) {
    .demo * { animation: none !important; }
    .bars i { background: var(--accent); }
    .bars i:nth-child(1) { height: 8px; }
    .bars i:nth-child(n + 2) { transform: scaleY(0.1); opacity: 0.25; }
    .s-loud { opacity: 0; }
    .s-quiet { opacity: 1; }
    .line span { clip-path: inset(0 0 0 0); }
  }

  @media (max-width: 560px) {
    .line { font-size: 16px; }
  }
</style>
