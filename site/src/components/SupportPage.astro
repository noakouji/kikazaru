---
import type { Copy } from '../copy'
import Base from '../layouts/Base.astro'
import Icon from './Icon.astro'

interface Props {
  t: Copy
}
const { t } = Astro.props
const c = t.page

const kofi = 'https://ko-fi.com/kojiokada'
const kofiPanel = `${kofi}/?hidefeed=true&widget=true&embed=true&preview=true`
const home = t.lang === 'ja' ? '/' : '/en'
const altPage = t.lang === 'ja' ? '/en/support' : '/support'
---

<Base title={c.title} description={c.description} htmlLang={t.htmlLang} altHref={altPage}>
  <nav class="topbar">
    <div class="shell bar-inner">
      <a class="back" href={home}>← {c.back}</a>
      <div class="lang" role="group" aria-label="Language">
        <a href="/support" class:list={['seg', { on: t.lang === 'ja' }]} title="日本語">JA</a>
        <a href="/en/support" class:list={['seg', { on: t.lang === 'en' }]} title="English">EN</a>
      </div>
    </div>
  </nav>

  <header class="head">
    <div class="shell">
      {/* 絵文字は必ず何かに属させる。単独で置くと孤立して見える */}
      <div class="badge"><span>🙉</span></div>
      <h1>{c.heading}</h1>
      <p class="lead">{c.lead}</p>
    </div>
  </header>

  {/* 読み終わらないと払えない作りにしない。金額は最初に見せる */}
  <section class="pay">
    <div class="shell pay-inner">
      <div class="pay-side">
        <h2><Icon name="coffee" size={20} />{c.payHeading}</h2>
        <p>{c.payNote}</p>
      </div>
      <iframe class="kofi" src={kofiPanel} title={c.payHeading} height="520" loading="lazy"></iframe>
    </div>
  </section>

  <main class="shell body">
    <section>
      <h2>{c.freeHeading}</h2>
      {c.freeBody.map((p) => <p class="para">{p}</p>)}
    </section>

    <section>
      <h2>{c.moneyHeading}</h2>
      <p class="para">{c.moneyBody}</p>
      <ul class="spend">
        {c.moneyList.map((item) => (
          <li>
            <span class="spend-ico"><Icon name={item.icon as any} size={20} /></span>
            <span class="spend-text">
              <strong>{item.title}</strong>
              <small>{item.note}</small>
            </span>
            <span class="cost">{item.cost}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="note-block">
      <h2><Icon name="check" size={18} />{c.nothingHeading}</h2>
      <p class="para">{c.nothingBody}</p>
    </section>

    <section>
      <h2>{c.otherHeading}</h2>
      <p class="para">{c.otherBody}</p>
      <div class="others">
        {c.otherList.map((o) => (
          <div class="other">
            <span class="other-ico"><Icon name={o.icon as any} size={22} /></span>
            <h3>{o.title}</h3>
            <p>{o.body}</p>
          </div>
        ))}
      </div>
    </section>

    <p class="closing">{c.closing}</p>

    <a class="back-foot" href={home}>
      <Icon name="arrow" size={17} />{c.back}
    </a>
  </main>
</Base>

<style>
  .shell {
    width: min(720px, calc(100% - 40px));
    margin-inline: auto;
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(247, 245, 241, 0.86);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }

  .bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 52px;
  }

  .back {
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    color: var(--ink-soft);
  }

  .back:hover { color: var(--ink); }

  .lang {
    display: inline-flex;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.03);
    padding: 2px;
  }

  .seg {
    min-width: 34px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
    text-decoration: none;
    padding: 7px 0;
    border-radius: 999px;
    display: grid;
    place-items: center;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .seg.on {
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
  }

  .head { padding: 58px 0 44px; }

  .badge {
    width: 68px;
    height: 68px;
    border-radius: 20px;
    background: var(--dark);
    display: grid;
    place-items: center;
    margin-bottom: 22px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.16);
  }

  .badge span { font-size: 36px; line-height: 1; }

  h1 {
    font-size: clamp(25px, 5vw, 36px);
    margin-bottom: 16px;
  }

  .lead {
    color: var(--ink-soft);
    font-size: 16px;
    max-width: 34em;
  }

  /* 払う場所。面の色を変えて、本文とは別のものだと分かるようにする */
  .pay {
    background: var(--paper-deep);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 34px 0;
  }

  .pay-inner {
    display: grid;
    grid-template-columns: 1fr 440px;
    gap: 32px;
    align-items: start;
  }

  .pay-side { padding-top: 6px; }

  .pay-side h2 { margin-bottom: 10px; }
  .pay-side p { font-size: 14px; color: var(--ink-soft); }

  .kofi {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #fff;
    display: block;
  }

  .body { padding: 52px 0 90px; }

  section { margin-bottom: 46px; }

  h2 {
    font-size: 18px;
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    gap: 9px;
  }

  h2 :global(.icon) { color: var(--accent); }

  .para {
    color: var(--ink-soft);
    font-size: 15px;
  }

  .para + .para { margin-top: 12px; }

  /* 何にいくら使うのかを、金額まで並べて1行で読ませる */
  .spend {
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 2px;
  }

  .spend li {
    display: grid;
    grid-template-columns: 40px 1fr auto;
    align-items: start;
    gap: 4px;
    padding: 15px 0;
    border-bottom: 1px solid var(--line);
  }

  .spend li:first-child { border-top: 1px solid var(--line); }

  .spend-ico { color: var(--ink-faint); padding-top: 1px; }

  .spend-text { display: block; }
  .spend-text strong { font-size: 15px; font-weight: 600; display: block; }

  .spend-text small {
    display: block;
    font-size: 13.5px;
    color: var(--ink-soft);
    margin-top: 3px;
    line-height: 1.7;
  }

  /* 等幅にすると日本語の字間が開いて間延びする。本文と同じ書体で色だけ変える */
  .cost {
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
    white-space: nowrap;
    padding-left: 16px;
    padding-top: 3px;
  }

  /* 「見返りは無い」は言いにくい話なので、面で囲って正面から置く */
  .note-block {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 22px 24px;
  }

  .note-block h2 { margin-bottom: 10px; }

  .others {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 18px;
  }

  .other {
    border: 1px solid var(--line);
    background: #fff;
    border-radius: 12px;
    padding: 18px;
  }

  .other-ico {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--accent-soft);
    color: var(--accent);
    margin-bottom: 12px;
  }

  .other h3 { font-size: 14.5px; margin-bottom: 6px; }
  .other p { font-size: 13.5px; color: var(--ink-soft); }

  .closing {
    color: var(--ink-soft);
    font-size: 15px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }

  .back-foot {
    margin-top: 32px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }

  .back-foot :global(.icon) { transform: rotate(180deg); }

  @media (max-width: 780px) {
    .pay-inner { grid-template-columns: 1fr; }
    .kofi { max-width: 440px; }
    .others { grid-template-columns: 1fr; }
  }
</style>
