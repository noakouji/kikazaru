---
import type { Copy } from '../copy'
import Icon from './Icon.astro'

interface Props {
  t: Copy
  downloadHref: string
  repoHref: string
}
const { t, downloadHref, repoHref } = Astro.props
---

<header class="hero">
  <div class="wrap">
    <div class="mark">🙉</div>
    <p class="name">Kikazaru</p>
    <h1 set:html={t.hero.tagline} />
    <p class="sub">{t.hero.sub}</p>

    <div class="cta">
      <a class="download" href={downloadHref} download>{t.hero.download}</a>
      {/* 未署名のアプリなので、中身を確かめる道を最初の画面から出しておく */}
      <a class="repo" href={repoHref} target="_blank" rel="noopener">
        <Icon name="github" size={17} />{t.hero.repo}
      </a>
      <span class="meta">{t.hero.meta}</span>
    </div>

    <p class="note">
      {t.hero.note[0]}<a href="#install">{t.hero.note[1]}</a>{t.hero.note[2]}
    </p>
  </div>
</header>

<style>
  .hero {
    padding: clamp(56px, 11vw, 104px) 0 clamp(48px, 8vw, 76px);
  }

  .mark {
    font-size: clamp(52px, 11vw, 76px);
    line-height: 1;
    margin-bottom: 20px;
  }

  .name {
    font-size: clamp(38px, 9vw, 68px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin-bottom: 12px;
  }

  h1 {
    font-size: clamp(20px, 3.6vw, 27px);
    color: var(--ink-soft);
    font-weight: 700;
    margin-bottom: 20px;
  }

  .sub {
    color: var(--ink-soft);
    font-size: clamp(15px, 2.2vw, 17px);
    max-width: 34em;
  }

  .cta {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 34px;
  }

  .download {
    display: inline-block;
    background: var(--dark);
    color: var(--paper);
    text-decoration: none;
    font-weight: 700;
    font-size: 16px;
    padding: 14px 26px;
    border-radius: 10px;
    /* 押せる紙のような影。派手なグラデーションは使わない */
    box-shadow: 0 2px 0 rgba(0, 0, 0, 0.28);
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }

  .download:hover {
    transform: translateY(1px);
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.28);
  }

  .repo {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-soft);
    text-decoration: none;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: 10px;
  }

  .repo:hover { color: var(--ink); background: var(--paper-deep); }

  .meta {
    font-size: 13px;
    color: var(--ink-faint);
  }

  .note {
    margin-top: 18px;
    font-size: 14px;
    color: var(--ink-soft);
  }

  .note a {
    color: var(--accent);
    text-underline-offset: 3px;
  }
</style>
