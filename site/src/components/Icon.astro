---
// 線画アイコン。外部の読み込みを一切しないので、表示が崩れることも
// ライセンス表記に悩むこともない。線の太さと角の丸めをサイト全体で揃える。
interface Props {
  name: 'coffee' | 'badge' | 'speaker' | 'globe' | 'bug' | 'share' | 'check' | 'arrow'
  size?: number
}
const { name, size = 22 } = Astro.props
---

<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'coffee' && (
    <>
      <path d="M4 9h13v6a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4z" />
      <path d="M17 10h1.6A2.4 2.4 0 0 1 21 12.4v0a2.4 2.4 0 0 1-2.4 2.4H17" />
      <path d="M8 3v2.5M12 3v2.5" />
    </>
  )}

  {name === 'badge' && (
    <>
      <path d="M12 3 4.5 6v5.2c0 4.2 3 7.4 7.5 9.8 4.5-2.4 7.5-5.6 7.5-9.8V6z" />
      <path d="m9 11.8 2.1 2.1L15 10" />
    </>
  )}

  {name === 'speaker' && (
    <>
      <rect x="6" y="2.5" width="12" height="19" rx="2.5" />
      <circle cx="12" cy="15" r="3.2" />
      <circle cx="12" cy="7" r="1.1" />
    </>
  )}

  {name === 'globe' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M3.5 9h17M3.5 15h17" />
      <path d="M12 3c2.4 2.4 3.6 5.4 3.6 9s-1.2 6.6-3.6 9c-2.4-2.4-3.6-5.4-3.6-9S9.6 5.4 12 3z" />
    </>
  )}

  {name === 'bug' && (
    <>
      <rect x="7.5" y="7.5" width="9" height="12" rx="4.5" />
      <path d="M9.5 6a2.5 2.5 0 0 1 5 0" />
      <path d="M7.5 11H4M20 11h-3.5M7.5 15.5H4.5M19.5 15.5h-3M8.5 19l-2 2M15.5 19l2 2" />
    </>
  )}

  {name === 'share' && (
    <>
      <circle cx="17.5" cy="5.5" r="2.5" />
      <circle cx="6" cy="12" r="2.5" />
      <circle cx="17.5" cy="18.5" r="2.5" />
      <path d="m8.2 10.8 7.1-4M8.2 13.2l7.1 4" />
    </>
  )}

  {name === 'check' && <path d="m5 12.5 4.5 4.5L19 7" />}

  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
</svg>

<style>
  .icon {
    display: block;
    flex: none;
  }
</style>
