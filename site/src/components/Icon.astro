---
// 線画アイコン。外部の読み込みを一切しないので、表示が崩れることも
// ライセンス表記に悩むこともない。線の太さと角の丸めをサイト全体で揃える。
interface Props {
  name: 'coffee' | 'badge' | 'speaker' | 'globe' | 'bug' | 'share' | 'check' | 'arrow' | 'github'
  size?: number
}
const { name, size = 22 } = Astro.props
---

<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'coffee' && (
    <>
      <path d="M4 9h13v6a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4z" />
      <path d="M17 10h1.6A2.4 2.4 0 0 1 21 12.4v0a2.4 2.4 0 0 1-2.4 2.4H17" />
      <path d="M8 3v2.5M12 3v2.5" />
    </>
  )}

  {name === 'badge' && (
    <>
      <path d="M12 3 4.5 6v5.2c0 4.2 3 7.4 7.5 9.8 4.5-2.4 7.5-5.6 7.5-9.8V6z" />
      <path d="m9 11.8 2.1 2.1L15 10" />
    </>
  )}

  {name === 'speaker' && (
    <>
      <rect x="6" y="2.5" width="12" height="19" rx="2.5" />
      <circle cx="12" cy="15" r="3.2" />
      <circle cx="12" cy="7" r="1.1" />
    </>
  )}

  {name === 'globe' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M3.5 9h17M3.5 15h17" />
      <path d="M12 3c2.4 2.4 3.6 5.4 3.6 9s-1.2 6.6-3.6 9c-2.4-2.4-3.6-5.4-3.6-9S9.6 5.4 12 3z" />
    </>
  )}

  {name === 'bug' && (
    <>
      <rect x="7.5" y="7.5" width="9" height="12" rx="4.5" />
      <path d="M9.5 6a2.5 2.5 0 0 1 5 0" />
      <path d="M7.5 11H4M20 11h-3.5M7.5 15.5H4.5M19.5 15.5h-3M8.5 19l-2 2M15.5 19l2 2" />
    </>
  )}

  {name === 'share' && (
    <>
      <circle cx="17.5" cy="5.5" r="2.5" />
      <circle cx="6" cy="12" r="2.5" />
      <circle cx="17.5" cy="18.5" r="2.5" />
      <path d="m8.2 10.8 7.1-4M8.2 13.2l7.1 4" />
    </>
  )}

  {name === 'check' && <path d="m5 12.5 4.5 4.5L19 7" />}

  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}

  {/* GitHub は線画だと崩れるので、公式と同じ塗りの形をそのまま置く */}
  {name === 'github' && (
    <path
      fill="currentColor"
      stroke="none"
      d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.31 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.24-.02-2.25-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.21.08 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.49 5.92.43.37.82 1.1.82 2.22 0 1.61-.02 2.9-.02 3.29 0 .32.22.7.83.58A12 12 0 0 0 24 12.5C24 5.87 18.63.5 12 .5z"
    />
  )}
</svg>

<style>
  .icon {
    display: block;
    flex: none;
  }
</style>
