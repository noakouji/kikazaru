---
import type { Copy } from '../copy'
import Figures from './Figures.astro'

interface Props {
  t: Copy
  formHref: string
}
const { t, formHref } = Astro.props
const c = t.install

// このページで一番大事なところ。
// 署名なしで配っているので、受け取った人は必ず一度ブロックされる。
// ここでつまずくと、アプリを触ってすらもらえない。図を添えて一段ずつ書く。
---

<section class="section" id="install">
  <div class="wrap">
    <p class="section-label">{c.label}</p>
    <h2>{c.heading}</h2>
    <p class="lead intro">{c.intro}</p>

    <div class="callout">
      <p>{c.calloutMain[0]}<strong>{c.calloutMain[1]}</strong>{c.calloutMain[2]}</p>
      <p class="small">{c.calloutSub}</p>
    </div>

    <ol class="steps">
      {c.steps.map((step) => (
        <li class={step.key ? 'key' : undefined}>
          <div class="text">
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </div>
          {step.figure && (
            <figure><Figures kind={step.figure} lang={t.lang} /></figure>
          )}
        </li>
      ))}
    </ol>

    <div class="after">
      <h3>{c.afterHeading}</h3>
      <p>{c.afterBody[0]}<strong>{c.afterBody[1]}</strong></p>
      <figure class="wide">
        <img src={t.shot.image} width="650" height="900" alt={t.shot.alt} loading="lazy" />
      </figure>
      <p class="small">{c.afterFine}</p>
    </div>

    <div class="trouble">
      <h3>{c.troubleHeading}</h3>
      <p>{c.troubleBody[0]}<strong>{c.troubleBody[1]}</strong>{c.troubleBody[2]}</p>
      <p class="small">
        {c.troubleTail[0]}
        <a href={formHref} target="_blank" rel="noopener">{c.troubleLink}</a>
        {c.troubleTail[1]}
      </p>
    </div>
  </div>
</section>

<style>
  .intro { margin-bottom: 26px; }

  .callout {
    background: var(--accent-soft);
    border: 1px solid #e3cdb8;
    border-radius: 12px;
    padding: 20px 22px;
    display: grid;
    gap: 12px;
    margin-bottom: 40px;
  }

  .callout p { font-size: 15px; }
  .small { font-size: 13.5px; color: var(--ink-soft); }

  .steps {
    counter-reset: step;
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 34px;
  }

  .steps li {
    counter-increment: step;
    padding-left: 48px;
    position: relative;
  }

  .steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0;
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--dark);
    color: var(--paper);
    font-size: 15px;
    font-weight: 700;
  }

  .steps li.key::before { background: var(--accent); }

  .steps h3 {
    font-size: 17px;
    margin-bottom: 6px;
  }

  .steps p {
    font-size: 14.5px;
    color: var(--ink-soft);
  }

  figure {
    margin: 14px 0 0;
    max-width: 460px;
  }

  figure.wide { max-width: 380px; margin-top: 16px; }

  figure img {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--line);
    border-radius: 10px;
  }

  code {
    background: var(--paper-deep);
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 1px 6px;
    font-size: 0.92em;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .after {
    margin-top: 44px;
    padding: 24px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 12px;
  }

  .after h3 { font-size: 17px; margin-bottom: 8px; }
  .after p { font-size: 14.5px; color: var(--ink-soft); }
  .after .small { margin-top: 12px; }

  .trouble {
    margin-top: 38px;
    padding-top: 26px;
    border-top: 1px dashed var(--line);
  }

  .trouble h3 { font-size: 16px; margin-bottom: 10px; }
  .trouble p { font-size: 14.5px; color: var(--ink-soft); }
  .trouble p + p { margin-top: 10px; }
  .trouble a { color: var(--accent); }
</style>
