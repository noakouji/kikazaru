---
import Base from '../layouts/Base.astro'
import Hero from '../components/Hero.astro'
import Problem from '../components/Problem.astro'
import Install from '../components/Install.astro'
import Support from '../components/Support.astro'

// 差し替えが1か所で済むように、外部リンクはここにまとめる。
const links = {
  download: '/Kikazaru.zip',
  form: 'https://docs.google.com/forms/d/e/1FAIpQLSefXhorrRPZcoxn_hRgREMqL48qcicouq6lu3wExYi97xUYjQ/viewform',
  kofi: 'https://ko-fi.com/kojiokada',
}
const downloadSize = '約 400 KB'

const steps = [
  { emoji: '🎙', title: '話し始める', body: 'マイクがオンになったことを検知します' },
  { emoji: '🙉', title: 'BGMが下がる', body: '約0.1秒でスピーカーの音量を下げます' },
  { emoji: '🐵', title: '話し終わる', body: '元の音量にそのまま戻します' },
]

const speakers = [
  { name: 'Sonos', note: '推奨。実機で確認済み', state: 'ok' },
  { name: 'Google Home / Chromecast', note: '実機で確認済み', state: 'ok' },
  { name: 'Bose SoundTouch', note: '実機がないため未確認', state: 'wip' },
  { name: 'Mac から鳴らしているスピーカー', note: '設定で有効にできます', state: 'sub' },
]
---

<Base
  title="Kikazaru — マイクがオンの間だけ、部屋のBGMを下げる Mac アプリ"
  description="音声入力やオンライン会議のあいだ、Sonos や Google Home の音量を自動で下げます。話し終わると元に戻ります。macOS 用・無料。"
>
  <nav class="topbar">
    <div class="wrap bar-inner">
      <span class="brand"><span class="brand-mark">🙉</span> Kikazaru</span>
      <a class="bar-dl" href={links.download} download>ダウンロード</a>
    </div>
  </nav>

  <Hero downloadHref={links.download} size={downloadSize} />

  <section class="shot-band">
    <div class="wrap shot-inner">
      <img
        class="shot"
        src="/app-settings.png"
        width="900"
        height="1080"
        alt="Kikazaru の設定画面。見つかったスピーカーが並び、下げたいものにチェックを入れる"
        loading="lazy"
      />
      <div class="shot-note">
        <h2>設定はこれだけ</h2>
        <p>
          同じネットワークにあるスピーカーが自動で並びます。
          <strong>下げたいものにチェックを入れれば終わり</strong>で、
          IPアドレスの入力なども要りません。
        </p>
        <p class="fine">
          Sonos 以外は、うっかりテレビを下げてしまわないよう初期状態ではオフです。
          アプリごとに「下げる／ミュートする」を選ぶこともできます。
        </p>
      </div>
    </div>
  </section>

  <Problem />

  <section class="section">
    <div class="wrap">
      <p class="section-label">動き</p>
      <h2>入れておくだけで、あとは勝手に</h2>
      <div class="steps">
        {steps.map((s) => (
          <div class="step">
            <span class="emoji">{s.emoji}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        ))}
      </div>
      <p class="lead">
        メニューバーの絵文字が 🐵 と 🙉 で切り替わるので、
        いま下がっているかどうかが一目で分かります。
        待機中は何も動かないので、電池もほとんど食いません。
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="section-label">対応スピーカー</p>
      <h2>ネットワーク上のスピーカーを自動で探します</h2>
      <ul class="speakers">
        {speakers.map((s) => (
          <li class={s.state}>
            <span class="dot"></span>
            <strong>{s.name}</strong>
            <span class="note">{s.note}</span>
          </li>
        ))}
      </ul>
      <p class="lead">
        IPアドレスの入力は要りません。Sonos 以外は、うっかりテレビを下げてしまわないよう
        初期状態ではオフになっています。設定でチェックを入れると有効になります。
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="section-label">なぜ作ったか</p>
      <h2>これから、喋って書く時間はもっと増える</h2>
      <p class="lead ctx">
        AI に指示を出すのも、議事録をまとめるのも、キーボードより口のほうが速い場面が増えました。
        Aqua Voice のような音声入力を一日中使うようになると、それまで気にならなかった
        「スピーカーの音がマイクに入る」が、毎回の小さなストレスとして効いてきます。
      </p>
      <p class="lead ctx">
        そのたびに音楽を止めたり、ヘッドホンに付け替えたりするのが面倒で作りました。
        <strong>Kikazaru を入れておけば、音楽は流したままで構いません。</strong>
      </p>
    </div>
  </section>

  <Install formHref={links.form} />
  <Support formHref={links.form} kofiHref={links.kofi} />

  <footer class="foot">
    <div class="wrap">
      <p class="made">
        Sonos と Google Home を使っていて自分が困ったので作りました。
        かなりニッチな道具だという自覚はあります。
      </p>
      <div class="foot-links">
        <a href="#install">インストール方法</a>
        <a href="#support">要望・バグ報告</a>
      </div>
      <p class="copy">Kikazaru · macOS 14 以降 · 無料</p>
    </div>
  </footer>
</Base>

<style>
  .shot-band {
    background: var(--paper-deep);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 56px 0;
  }

  .shot-inner {
    display: grid;
    grid-template-columns: 330px 1fr;
    gap: 40px;
    align-items: center;
  }

  .shot {
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--line);
    /* 画面を切り出したものなので、浮かせて実物らしく見せる */
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.14);
  }

  .shot-note h2 { font-size: clamp(20px, 3.6vw, 26px); margin-bottom: 14px; }
  .shot-note p { font-size: 15px; color: var(--ink-soft); }
  .shot-note p + p { margin-top: 12px; }
  .shot-note strong { color: var(--ink); }
  .fine { font-size: 13.5px; }

  @media (max-width: 720px) {
    .shot-inner { grid-template-columns: 1fr; gap: 24px; }
    .shot { max-width: 320px; }
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(247, 245, 241, 0.86);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }

  .bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 52px;
  }

  .brand {
    font-weight: 700;
    letter-spacing: 0.01em;
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .brand-mark { font-size: 19px; }

  .bar-dl {
    font-size: 13.5px;
    font-weight: 700;
    text-decoration: none;
    padding: 7px 14px;
    border-radius: 7px;
    background: var(--dark);
    color: var(--paper);
  }

  .ctx { max-width: 38em; }
  .ctx + .ctx { margin-top: 14px; }
  .ctx strong { color: var(--ink); }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-bottom: 24px;
  }

  .step {
    border: 1px solid var(--line);
    background: #fff;
    border-radius: 12px;
    padding: 20px;
  }

  .emoji { font-size: 28px; display: block; margin-bottom: 8px; }
  .step h3 { font-size: 16px; margin-bottom: 4px; }
  .step p { font-size: 14px; color: var(--ink-soft); }

  .speakers {
    list-style: none;
    padding: 0;
    margin: 0 0 22px;
    display: grid;
    gap: 2px;
  }

  .speakers li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 11px 2px;
    border-bottom: 1px solid var(--line);
    flex-wrap: wrap;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex: none;
    transform: translateY(-1px);
  }

  .ok .dot { background: var(--ok); }
  .wip .dot { background: #d08a3c; }
  .sub .dot { background: var(--ink-faint); }

  .speakers strong { font-weight: 600; }
  .note { font-size: 13.5px; color: var(--ink-faint); }

  .foot {
    border-top: 1px solid var(--line);
    padding: 46px 0 64px;
  }

  .made {
    color: var(--ink-soft);
    font-size: 15px;
    max-width: 32em;
  }

  .foot-links {
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
    margin: 20px 0 26px;
  }

  .foot-links a {
    color: var(--accent);
    font-size: 15px;
    text-underline-offset: 3px;
  }

  .copy { font-size: 13px; color: var(--ink-faint); }

  @media (max-width: 640px) {
    .steps { grid-template-columns: 1fr; }
  }
</style>
